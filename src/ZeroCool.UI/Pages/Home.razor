@page "/"
@inject PlanRepository PlanRepo
@inject PlantCatalogRepository CatalogRepo
@inject SettingsRepository SettingsRepo

<PageTitle>ZeroCool Gardening</PageTitle>

<div class="mb-4">
    <h1>🌱 ZeroCool Gardening</h1>
    <p class="text-muted mb-2">
        Design your yard, plan square-foot, row, and container beds, check companion plantings, and follow your zone-based planting calendar.
    </p>
    @if (_settings is not null)
    {
        <div class="small">
            @if (_settings.UsdaZone is int z)
            {
                <span class="badge bg-info text-dark me-2">USDA Zone @z</span>
            }
            else
            {
                <a href="settings" class="badge bg-warning text-dark text-decoration-none me-2">Set your USDA Growing Zone →</a>
            }
            <span class="text-muted">@_plantCount plants &amp; @_varietyCount varieties in catalog</span>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="plans" class="card h-100 p-3 text-decoration-none text-dark">
            <h5 class="mb-1">🗺️ Garden Plans</h5>
            <p class="small text-muted mb-0">Create yards, shape grids, drag beds &amp; pavers, use starter templates, or import/export JSON.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="calendar" class="card h-100 p-3 text-decoration-none text-dark">
            <h5 class="mb-1">📅 Planting Calendar</h5>
            <p class="small text-muted mb-0">Start indoors, direct sow, transplant, and harvest dates tailored to your frost dates, with .ics export.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="plants" class="card h-100 p-3 text-decoration-none text-dark">
            <h5 class="mb-1">🍅 Plants &amp; Varieties</h5>
            <p class="small text-muted mb-0">Browse, add, or edit plants and varieties, spacing, companions, health benefits, and safety warnings.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="settings" class="card h-100 p-3 text-decoration-none text-dark">
            <h5 class="mb-1">⚙️ Settings</h5>
            <p class="small text-muted mb-0">Set your USDA growing zone, customize frost dates, and choose Imperial or Metric units.</p>
        </a>
    </div>
</div>

@if (_recentPlans is { Count: > 0 })
{
    <h5 class="mb-2">Recent Garden Plans</h5>
    <div class="list-group" style="max-width: 640px;">
        @foreach (var plan in _recentPlans)
        {
            <a href="plan/@plan.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <span><strong>@plan.Name</strong></span>
                <small class="text-muted">@plan.GridWidth × @plan.GridHeight ft · @plan.Beds.Count bed(s)</small>
            </a>
        }
    </div>
}

@code {
    private List<GardenPlan>? _recentPlans;
    private AppSettings? _settings;
    private int _plantCount;
    private int _varietyCount;

    protected override async Task OnInitializedAsync()
    {
        var plans = await PlanRepo.ListAsync(templates: false);
        _recentPlans = plans.OrderByDescending(p => p.ModifiedUtc).Take(5).ToList();
        var catalog = await CatalogRepo.GetAllAsync();
        _plantCount = catalog.Count;
        _varietyCount = catalog.Sum(p => p.Varieties.Count);
        _settings = await SettingsRepo.LoadAsync();
    }
}
