@page "/"

<PageTitle>ZeroCool Gardening</PageTitle>

<h1>🌱 ZeroCool Gardening</h1>
<p>Hello from the shared UI library, running on <strong>@Platform</strong>.</p>

@code {
    private static string Platform =>
        OperatingSystem.IsAndroid() ? "Android"
        : OperatingSystem.IsWindows() ? "Windows"
        : OperatingSystem.IsBrowser() ? "Browser"
        : "Web server";
}

